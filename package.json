{
  "name": "react-moment",
  "description": "React component for the moment date library.",
  "version": "2.0.0-beta.1",
  "author": {
    "name": "Sean Hickey",
    "web": "https://headzoo.io"
  },
  "devDependencies": {
    "@babel/core": "^7.4.3",
    "@babel/plugin-proposal-class-properties": "^7.4.0",
    "@babel/preset-env": "^7.4.3",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-stage-2": "^7.0.0",
    "@babel/register": "^7.4.0",
    "@storybook/addon-actions": "^5.0.6",
    "@storybook/addon-knobs": "^5.0.6",
    "@storybook/addon-options": "^5.0.6",
    "@storybook/addons": "^5.0.6",
    "@storybook/react": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-eslint": "^10.0.1",
    "babel-loader": "^8.0.5",
    "coveralls": "^3.0.3",
    "eslint": "^10.4.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-import-resolver-babel-module": "^5.0.1",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-react": "^7.12.4",
    "express": "^4.16.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "json-loader": "^0.5.4",
    "moment": "^2.29.0",
    "moment-duration-format": "^2.2.2",
    "moment-timezone": "^0.5.23",
    "react": "^16.0.0",
    "react-dom": "^16.0.0",
    "rimraf": "^2.6.3",
    "storybook-addon-jsx": "^7.1.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^8.4.0",
    "typescript": "^5.9.3",
    "webpack": "^4.29.6",
    "webpack-cli": "^3.3.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testRegex": "\\.(test|spec)\\.(ts|tsx)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.spec.{ts,tsx}"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "keywords": [
    "date",
    "moment",
    "react",
    "react-component",
    "time"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "peerDependencies": {
    "moment": "^2.29.0",
    "react": "^16.0 || ^17.0.0 || ^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/headzoo/react-moment.git"
  },
  "scripts": {
    "build": "npm run clean && webpack -p && tsc --emitDeclarationOnly -p tsconfig.json",
    "clean": "rimraf ./dist",
    "prepare": "git config --local core.hooksPath .githooks 2>/dev/null || true",
    "release": "gh workflow run Release --ref master -f release_type=patch",
    "release:patch": "gh workflow run Release --ref master -f release_type=patch",
    "release:minor": "gh workflow run Release --ref master -f release_type=minor",
    "release:major": "gh workflow run Release --ref master -f release_type=major",
    "release:beta": "gh workflow run release-beta.yml --ref master",
    "test": "export TZ=America/New_York; jest --coverage",
    "travis-test": "npm run test && cat ./coverage/lcov.info | ./node_modules/.bin/coveralls",
    "lint": "eslint ./src --cache --cache-location=.cache/eslint --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "storybook:dev": "start-storybook -p 6006",
    "storybook:build": "build-storybook -o stories/build"
  },
  "types": "dist/index.d.ts"
}
